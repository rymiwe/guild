[Unit]
Description=Refresh the Guild outcome ledger from Conclave runs and GitHub

[Service]
Type=oneshot
TimeoutStartSec=30min
# guild-exec runs ~/code/guild only when it is clean and on its default branch.
# linuxbrew comes before /usr/bin: the system python3 on BLD is too old.
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/guild-exec guild bin/guild-ledger refresh
