#!/usr/bin/env python3
"""Fake gh for work-review-requests-check tests. Reads $FAKE_GH_FIXTURE (JSON):
  {"search": {"<repo>|requested|drafts|reviewed": [items...]},
   "api": {"<path without leading slash>": <json>},
   "fail": ["<substring of q or path>", ...]}
Supports: gh api [-X GET] <path> [-f k=v ...] [-q JQ]. Logs every call to $FAKE_GH_LOG.
Read-only by construction: any -X other than GET exits 99."""
import json, os, re, subprocess, sys
args = sys.argv[1:]
log = os.environ.get("FAKE_GH_LOG")
if log:
    open(log, "a").write(" ".join(args) + "\n")
if not args or args[0] != "api":
    sys.exit(98)
fixture = json.load(open(os.environ["FAKE_GH_FIXTURE"]))
path = None; fields = {}; jq = None; i = 1
while i < len(args):
    a = args[i]
    if a == "-X":
        if args[i + 1] != "GET": sys.exit(99)
        i += 2; continue
    if a == "-f": k, v = args[i + 1].split("=", 1); fields[k] = v; i += 2; continue
    if a == "-q": jq = args[i + 1]; i += 2; continue
    path = a; i += 1
for f in fixture.get("fail", []):
    if f in (path or "") or f in fields.get("q", ""):
        print("HTTP 502", file=sys.stderr); sys.exit(1)
if path == "search/issues":
    q = fields.get("q", "")
    repo = re.search(r"repo:(\S+)", q).group(1)
    kind = "drafts" if "draft:true" in q else ("reviewed" if "reviewed-by:" in q else "requested")
    out = {"items": fixture.get("search", {}).get(f"{repo}|{kind}", [])}
else:
    p = path.split("?")[0]
    if p not in fixture.get("api", {}):
        print(f"HTTP 404 {p}", file=sys.stderr); sys.exit(1)
    out = fixture["api"][p]
s = json.dumps(out)
if jq:
    r = subprocess.run(["jq", "-r", jq], input=s, text=True, capture_output=True)
    sys.stdout.write(r.stdout); sys.exit(r.returncode)
print(s)
