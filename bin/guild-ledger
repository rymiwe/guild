#!/usr/bin/env python3
"""The Guild outcome ledger: what each tool decided, and what happened next.

usage: guild-ledger append                      < one event as JSON on stdin
       guild-ledger backfill [--council-dir DIR]
       guild-ledger backfill-prs --repo OWNER/NAME [--repo ...] [--days N]
       guild-ledger refresh [--council-dir DIR]
       guild-ledger touches [--days N] [--repo OWNER/NAME ...]

Ledger: $GUILD_LEDGER (default ~/.local/state/guild/ledger.jsonl), append-only
JSONL. The schema and the backfill's proxy are in docs/outcome-ledger.md.

append   validates one event, computes its id, and appends it unless that id is
         already in the ledger. Prints "appended <id>" or "exists <id>".
backfill reads Conclave's posted.json and findings.json runs and appends a
         decision per posted review and finding, and an outcome per finding
         from GitHub (REST only). A rerun on unchanged state appends nothing.
backfill-prs
         appends an outcome per PR merged or closed in the last N days (default
         30) on each repo, from GitHub (REST only), and prints per-repo cycle
         time and reverts. A rerun on unchanged state appends nothing.
refresh  runs backfill, then backfill-prs over Guild, each roster tool and the
         org's guild-ledger.pr_repos (guild-config --org). A failed step sends
         one job-notify ping per kind until that step passes again; the other
         step still runs. guild-ledger-refresh.timer runs it daily.
touches  joins human_stop decisions to pr-lifecycle outcomes by (repo, pr) in
         the last N days (default 7) from the ledger file alone and prints
         merged PRs, human stops on them, touches per merged PR, and counts by
         stop name per repo.

Council dir: --council-dir, else $GUILD_LEDGER_COUNCIL_DIR, else
~/code/conclave/tmp/council.

Exit: 0 done; 2 malformed event or bad arguments, nothing written; 3 the ledger,
an input file, the config or GitHub could not be read (refresh: any step failed).
"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import math
import statistics
import subprocess
import sys
from collections import Counter
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.parse import quote

VERSION = 1
KINDS = {"decision": "action", "outcome": "proxy"}  # kind -> required data key
FIELDS = {"v", "id", "kind", "source", "subject", "at", "data", "recorded_at"}
SUBJECT_FIELDS = {"repo", "pr", "sha", "finding"}
REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
SHA_RE = re.compile(r"^[0-9a-f]{40}$")
PROXY = "cited-code-at-head"
PR_PROXY = "pr-lifecycle"
HUMAN_STOP_ACTION = "human_stop"
HUMAN_STOPS = {"split_decision", "posting_go", "manual_merge", "ack_loop", "one_way_ack", "brief_approval"}
TOUCHES_DAYS = 7
PAGE = 100
REVERTS_RE = re.compile(r"\bReverts\s+\[?(?:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#(\d+)")
EXIT_OK, EXIT_BAD_EVENT, EXIT_UNREADABLE = 0, 2, 3


class BadEvent(Exception):
    pass


class Unreadable(Exception):
    pass


# --- schema ------------------------------------------------------------

def ledger_path() -> Path:
    return Path(os.environ.get("GUILD_LEDGER") or os.path.expanduser("~/.local/state/guild/ledger.jsonl"))


def event_id(event: dict) -> str:
    body = {k: v for k, v in event.items() if k not in ("id", "recorded_at")}
    canonical = json.dumps(body, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def is_time(value) -> bool:
    if not isinstance(value, str):
        return False
    try:
        datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return False
    return True


def validate(event) -> dict:
    """Return the event with id and recorded_at set, or raise BadEvent."""
    if not isinstance(event, dict):
        raise BadEvent("event must be a JSON object")
    extra = set(event) - FIELDS
    if extra:
        raise BadEvent(f"unknown fields: {sorted(extra)}")
    if event.get("v") != VERSION or isinstance(event.get("v"), bool):
        raise BadEvent(f"v must be {VERSION}")
    kind = event.get("kind")
    if kind not in KINDS:
        raise BadEvent(f"kind must be one of {sorted(KINDS)}")
    if not isinstance(event.get("source"), str) or not event["source"].strip():
        raise BadEvent("source must be a non-empty string")
    subject = event.get("subject")
    if not isinstance(subject, dict) or set(subject) - SUBJECT_FIELDS:
        raise BadEvent(f"subject must be an object with only {sorted(SUBJECT_FIELDS)}")
    if not isinstance(subject.get("repo"), str) or not REPO_RE.match(subject["repo"]):
        raise BadEvent("subject.repo must be OWNER/NAME")
    pr = subject.get("pr")
    if not isinstance(pr, int) or isinstance(pr, bool) or pr < 1:
        raise BadEvent("subject.pr must be a positive integer")
    if not isinstance(subject.get("sha"), str) or not SHA_RE.match(subject["sha"]):
        raise BadEvent("subject.sha must be a 40-character lowercase hex commit")
    finding = subject.get("finding")
    if finding is not None and (not isinstance(finding, str) or not finding.strip()):
        raise BadEvent("subject.finding must be a non-empty string or null")
    if "at" not in event or (event["at"] is not None and not is_time(event["at"])):
        raise BadEvent("at must be an ISO 8601 time or null")
    data = event.get("data")
    need = KINDS[kind]
    if not isinstance(data, dict) or not isinstance(data.get(need), str) or not data[need]:
        raise BadEvent(f"data must be an object with a {need} string for a {kind}")
    if kind == "decision" and data["action"] == HUMAN_STOP_ACTION:
        if data.get("stop") not in HUMAN_STOPS:
            raise BadEvent(f"data.stop must be one of {sorted(HUMAN_STOPS)} for action {HUMAN_STOP_ACTION}")
        if data.get("answered_at") is not None and not is_time(data["answered_at"]):
            raise BadEvent("data.answered_at must be an ISO 8601 time or null")
    if "recorded_at" in event and not is_time(event["recorded_at"]):
        raise BadEvent("recorded_at must be an ISO 8601 time")
    clean = {k: v for k, v in event.items() if k not in ("id", "recorded_at")}
    clean["subject"] = {"repo": subject["repo"], "pr": pr, "sha": subject["sha"], "finding": finding}
    computed = event_id(clean)
    if "id" in event and event["id"] != computed:
        raise BadEvent(f"id {event['id']!r} does not match the event's content ({computed})")
    clean["id"] = computed
    clean["recorded_at"] = event.get("recorded_at") or datetime.now(timezone.utc).isoformat(timespec="seconds")
    return clean


def append_events(events: list[dict]) -> list[bool]:
    """Append each validated event whose id is new. One lock for the whole batch."""
    path = ledger_path()
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "a+", encoding="utf-8") as fh:
            fcntl.flock(fh, fcntl.LOCK_EX)
            fh.seek(0)
            seen = set()
            for n, line in enumerate(fh, 1):
                if not line.strip():
                    continue
                try:
                    seen.add(json.loads(line)["id"])
                except (ValueError, KeyError, TypeError):
                    raise Unreadable(f"{path}:{n}: malformed ledger line")
            added = []
            for event in events:
                new = event["id"] not in seen
                if new:
                    fh.write(json.dumps(event, sort_keys=True, ensure_ascii=False) + "\n")
                    seen.add(event["id"])
                added.append(new)
            fh.flush()
            os.fsync(fh.fileno())
            return added
    except OSError as exc:
        raise Unreadable(f"{path}: {exc.strerror or exc}")


# --- GitHub (REST only) --------------------------------------------------

class GitHub:
    def __init__(self) -> None:
        self.calls = 0

    def _run(self, args: list[str]) -> subprocess.CompletedProcess:
        self.calls += 1
        try:
            return subprocess.run(["gh", "api", *args], capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.TimeoutExpired) as exc:
            raise Unreadable(f"gh api {args[-1]}: {exc}")

    def json(self, path: str, paginate: bool = False):
        args = ["--paginate", "--slurp", path] if paginate else [path]
        out = self._run(args)
        if out.returncode != 0:
            raise Unreadable(f"gh api {path}: {out.stderr.strip() or out.returncode}")
        try:
            data = json.loads(out.stdout)
        except ValueError:
            raise Unreadable(f"gh api {path}: unparseable response")
        if paginate:
            return [item for page in data for item in page]
        return data

    def raw(self, repo: str, file: str, sha: str):
        """The file's text at sha, or None when GitHub says it is not there."""
        path = f"repos/{repo}/contents/{quote(file, safe='/')}?ref={sha}"
        out = self._run(["-H", "Accept: application/vnd.github.raw", path])
        if out.returncode == 0:
            return out.stdout
        if "(HTTP 404)" in out.stderr:
            return None
        raise Unreadable(f"gh api {path}: {out.stderr.strip() or out.returncode}")


# --- backfill ------------------------------------------------------------

def norm(text: str) -> str:
    return re.sub(r"\s+", " ", text or "").strip()


def load_json(path: Path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise Unreadable(f"{path}: {exc}")


def finding_details(council: Path, finding: dict) -> tuple[str | None, str]:
    path = council / str(finding.get("ballot", "")) / "findings.json"
    if not finding.get("ballot") or not path.is_file():
        return None, "unknown"
    data = load_json(path)
    verified_at = bool(data.get("verified_at")) if isinstance(data, dict) else False
    items = data if isinstance(data, list) else data.get("findings", []) if isinstance(data, dict) else []
    for item in items:
        if isinstance(item, dict) and item.get("id") == finding.get("id"):
            if item.get("repro_executed") is True:
                tier = "executed"
            elif verified_at:
                tier = "checked"
            else:
                tier = "none"
            return item.get("cited_code"), tier
    return None, "unknown"


def cited_result(gh: GitHub, cache: dict, repo: str, file, code, reviewed: str, head: str) -> dict:
    if not file:
        return {"result": "untestable", "reason": "no_path"}
    needle = norm(max(code.splitlines(), key=len)) if isinstance(code, str) and code.strip() else ""
    if not needle:
        return {"result": "untestable", "reason": "no_cited_code"}

    def text(sha):
        if (file, sha) not in cache:
            cache[(file, sha)] = gh.raw(repo, file, sha)
        return cache[(file, sha)]

    before = text(reviewed)
    if before is None or needle not in norm(before):
        return {"result": "untestable", "reason": "control_failed"}
    after = text(head)
    if after is None:
        return {"result": "file_deleted"}
    return {"result": "present" if needle in norm(after) else "gone"}


def later(a, b) -> bool:
    parse = lambda s: datetime.fromisoformat(s.replace("Z", "+00:00"))
    return parse(a) > parse(b)


def backfill(council: Path) -> int:
    gh = GitHub()
    events, outcomes, tiered = [], [], []
    if not council.is_dir():
        raise Unreadable(f"{council}: not a directory")
    runs = sorted(council.glob("*/posted.json"))
    for posted_path in runs:
        posted = load_json(posted_path)
        repo = posted.get("repo")
        for num, review in sorted(posted.get("reviews", {}).items(), key=lambda kv: int(kv[0])):
            pr = gh.json(f"repos/{repo}/pulls/{num}")
            comments = gh.json(f"repos/{repo}/pulls/{num}/comments?per_page=100", paginate=True)
            author = pr["user"]["login"]
            head = pr["head"]["sha"]
            merged_at = pr.get("merged_at")
            pr_state = "merged" if merged_at else pr["state"]
            replies: dict[int, list[str]] = {}
            for c in comments:
                if c.get("in_reply_to_id"):
                    replies.setdefault(c["in_reply_to_id"], []).append(c["user"]["login"])
            reviewed = review.get("commit_id")
            posted_at = review.get("posted_at")
            base = {"repo": repo, "pr": int(num), "sha": reviewed}
            events.append({"v": VERSION, "kind": "decision", "source": "conclave",
                           "subject": {**base, "finding": None}, "at": posted_at,
                           "data": {"action": "review_posted", "state": review.get("state"),
                                    "review_id": review.get("review_id")}})
            cache: dict = {}
            for key, f in sorted(review.get("findings", {}).items()):
                subject = {**base, "finding": f.get("id") or key}
                events.append({"v": VERSION, "kind": "decision", "source": "conclave",
                               "subject": subject, "at": posted_at,
                               "data": {"action": "finding_posted", "posted_as": f.get("posted_as"),
                                        "path": f.get("path"), "line": f.get("line"),
                                        "comment_id": f.get("comment_id"), "severity": f.get("severity")}})
                who = replies.get(f.get("comment_id"), []) if f.get("comment_id") else []
                code, tier = finding_details(council, f)
                observed = cited_result(gh, cache, repo, f.get("path"),
                                        code, reviewed, head)
                outcome = {"v": VERSION, "kind": "outcome", "source": "github", "subject": subject,
                           "at": merged_at or pr.get("closed_at"),
                           "data": {"proxy": PROXY, **observed, "pr_state": pr_state, "head_sha": head,
                                    "merged_at": merged_at, "replies": len(who),
                                    "author_replied": author in who,
                                    "posted_after_merge": bool(merged_at and posted_at
                                                               and later(posted_at, merged_at))}}
                events.append(outcome)
                outcomes.append(outcome["data"])
                tiered.append((outcome["data"], tier))
    try:
        valid = [validate(e) for e in events]
    except BadEvent as exc:
        raise Unreadable(f"{council}: input makes a malformed event: {exc}")
    added = append_events(valid)

    results = Counter(o["result"] for o in outcomes)
    testable = [o for o in outcomes if o["result"] != "untestable"]
    present = [o for o in outcomes if o["result"] == "present"]
    replied = sum(1 for o in present if o["author_replied"])
    untestable = Counter(o.get("reason") for o in outcomes if o["result"] == "untestable")
    reviews = sum(1 for e in valid if e["data"].get("action") == "review_posted")
    print(f"posted reviews {reviews}  posted findings {len(outcomes)}  testable {len(testable)}")
    print(f"cited code at head: gone {results['gone']}  present {results['present']}"
          f"  file_deleted {results['file_deleted']}"
          f"  untestable {sum(untestable.values())} {dict(sorted(untestable.items()))}")
    print(f"still present: author replied {replied}  no author reply {len(present) - replied}")
    print(f"posted after merge {sum(1 for o in outcomes if o['posted_after_merge'])}")
    tiers = []
    for tier in ("executed", "checked", "none", "unknown"):
        rows = [o for o, t in tiered if t == tier]
        if not rows:
            continue
        t_testable = sum(1 for o in rows if o["result"] != "untestable")
        t_gone = sum(1 for o in rows if o["result"] == "gone")
        tiers.append(f"{tier} {t_gone}/{t_testable} gone ({len(rows)} total)")
    if tiers:
        print("by verification: " + "  ".join(tiers))
    print(f"events appended {sum(added)}  already in ledger {len(added) - sum(added)}  REST calls {gh.calls}")
    return EXIT_OK


# --- backfill-prs ----------------------------------------------------------

def parse_time(value: str) -> datetime:
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def is_bot(user) -> bool:
    return not user or user.get("type") == "Bot" or user.get("login", "").endswith("[bot]")


def closed_prs(gh: GitHub, repo: str, since: datetime) -> list[dict]:
    """PRs closed at or after since. Pages newest-updated first and stops once a page
    reaches PRs last updated before since: a PR's close is never after its last update."""
    found, page = [], 1
    while True:
        batch = gh.json(f"repos/{repo}/pulls?state=closed&sort=updated&direction=desc"
                        f"&per_page={PAGE}&page={page}")
        found += [pr for pr in batch if pr.get("closed_at") and parse_time(pr["closed_at"]) >= since]
        if len(batch) < PAGE or parse_time(batch[-1]["updated_at"]) < since:
            return sorted(found, key=lambda pr: pr["number"])
        page += 1


def lifecycle(gh: GitHub, repo: str, pr: dict) -> dict:
    author = pr["user"]["login"]
    reviews = gh.json(f"repos/{repo}/pulls/{pr['number']}/reviews?per_page={PAGE}", paginate=True)
    counted = [r for r in reviews if r.get("state") != "PENDING" and not is_bot(r.get("user"))
               and r["user"]["login"] != author]
    merged_at = pr.get("merged_at")
    ended = merged_at or pr["closed_at"]
    title = pr.get("title") or ""
    is_revert = title.startswith("Revert")
    named = REVERTS_RE.search(pr.get("body") or "") if is_revert else None
    hours = (parse_time(ended) - parse_time(pr["created_at"])).total_seconds() / 3600
    return {"v": VERSION, "kind": "outcome", "source": "github",
            "subject": {"repo": repo, "pr": pr["number"], "sha": pr["head"]["sha"], "finding": None},
            "at": ended,
            "data": {"proxy": PR_PROXY, "state": "merged" if merged_at else "closed",
                     "author": author, "created_at": pr["created_at"],
                     ("merged_at" if merged_at else "closed_at"): ended,
                     "hours_open": round(hours, 4),
                     "reviewers": len({r["user"]["login"] for r in counted}),
                     "reviews": len(counted), "is_revert": is_revert,
                     "reverts_pr": int(named.group(1)) if named else None}}


def quantile(values: list[float], q: float) -> float:
    """Nearest rank: the smallest value with at least q of the values at or below it."""
    ordered = sorted(values)
    return ordered[max(0, math.ceil(q * len(ordered)) - 1)]


def backfill_prs(repos: list[str], days: int) -> int:
    gh = GitHub()
    since = datetime.now(timezone.utc) - timedelta(days=days)
    per_repo = {repo: [lifecycle(gh, repo, pr) for pr in closed_prs(gh, repo, since)] for repo in repos}
    try:
        valid = [validate(e) for events in per_repo.values() for e in events]
    except BadEvent as exc:
        raise Unreadable(f"GitHub response makes a malformed event: {exc}")
    added = append_events(valid)

    print(f"window {since.isoformat(timespec='seconds')} to now ({days} days)")
    for repo, events in per_repo.items():
        data = [e["data"] for e in events]
        merged = [d for d in data if d["state"] == "merged"]
        hours = [d["hours_open"] for d in merged]
        cycle = (f"median {statistics.median(hours):.2f} h  p90 {quantile(hours, 0.9):.2f} h"
                 if hours else "median - h  p90 - h")
        reverts = [d for d in merged if d["is_revert"]]
        named = sorted(d["reverts_pr"] for d in reverts if d["reverts_pr"])
        print(f"{repo}: merged {len(merged)}  closed unmerged {len(data) - len(merged)}  {cycle}"
              f"  reverts {len(reverts)} {named}  authors {len({d['author'] for d in data})}"
              f"  reviewed by others {sum(1 for d in merged if d['reviewers'])}")
    print(f"events appended {sum(added)}  already in ledger {len(added) - sum(added)}  REST calls {gh.calls}")
    return EXIT_OK


# --- refresh ---------------------------------------------------------------

ROOT = Path(__file__).resolve().parent.parent
PR_REPOS_KEY = "guild-ledger.pr_repos"
REFRESH_DAYS = 30
SHAPE_ERRORS = (KeyError, TypeError, ValueError, AttributeError)


def council_default() -> str:
    return os.environ.get("GUILD_LEDGER_COUNCIL_DIR") or os.path.expanduser("~/code/conclave/tmp/council")


def run_text(args: list[str], what: str) -> str:
    try:
        out = subprocess.run(args, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Unreadable(f"{what}: {exc}")
    if out.returncode != 0:
        raise Unreadable(f"{what}: exit {out.returncode}: {out.stderr.strip()}")
    return out.stdout


def refresh_repos() -> list[str]:
    """Guild itself, each roster tool under Guild's owner, then the org's PR_REPOS_KEY.
    The org list lives outside this public repo; a missing key fails closed."""
    url = run_text(["git", "-C", str(ROOT), "remote", "get-url", "origin"], f"origin of {ROOT}").strip()
    m = re.search(r"github\.com[:/]+([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+?)(?:\.git)?/?$", url)
    if not m:
        raise Unreadable(f"{ROOT}: cannot read OWNER/NAME from the origin URL")
    owner, name = m.groups()
    try:
        roster = (ROOT / "roster").read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise Unreadable(f"{ROOT / 'roster'}: {exc.strerror or exc}")
    tools = [line.split("#")[0].strip() for line in roster]
    org = json.loads(run_text(["guild-config", "--org", PR_REPOS_KEY], f"guild-config --org {PR_REPOS_KEY}"))
    if not isinstance(org, list) or not all(isinstance(r, str) and REPO_RE.match(r) for r in org):
        raise Unreadable(f"{PR_REPOS_KEY} must be a list of OWNER/NAME")
    repos = [f"{owner}/{name}", *(f"{owner}/{t}" for t in tools if t), *org]
    bad = [r for r in repos if not REPO_RE.match(r)]
    if bad:
        raise Unreadable(f"not OWNER/NAME: {bad}")
    return list(dict.fromkeys(repos))


def ping_once(kind: str, message: str) -> None:
    """One job-notify ping per failure kind; refresh clears the marker when the kind passes."""
    marker = ledger_path().parent / "refresh-pinged" / kind
    if marker.exists():
        return
    try:
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.touch()
    except OSError as exc:
        print(f"guild-ledger refresh: cannot write {marker}: {exc.strerror or exc}", file=sys.stderr)
    reason = "".join(c for c in f"{kind}: {message}" if c.isprintable() and c not in '\\"')[:300]
    try:
        out = subprocess.run(["job-notify", "--send", str(ledger_path().parent), "guild-ledger-refresh",
                              "FAILED", reason], capture_output=True, text=True, timeout=120)
        if out.returncode != 0:
            print(f"guild-ledger refresh: job-notify exit {out.returncode}", file=sys.stderr)
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f"guild-ledger refresh: job-notify failed: {exc}", file=sys.stderr)


def refresh(council: Path) -> int:
    steps = {"council": lambda: backfill(council),
             "prs": lambda: backfill_prs(refresh_repos(), REFRESH_DAYS)}
    failed = []
    for kind, step in steps.items():
        print(f"== {kind}", flush=True)
        try:
            step()
        except (Unreadable, *SHAPE_ERRORS) as exc:
            message = str(exc) if isinstance(exc, Unreadable) else f"unexpected shape: {exc!r}"
            print(f"guild-ledger refresh: {kind} failed: {message}", file=sys.stderr, flush=True)
            failed.append(kind)
            ping_once(kind, message)
        else:
            (ledger_path().parent / "refresh-pinged" / kind).unlink(missing_ok=True)
        sys.stdout.flush()
    print(f"refresh {'FAILED: ' + ' '.join(failed) if failed else 'ok'}")
    return EXIT_UNREADABLE if failed else EXIT_OK


# --- touches ---------------------------------------------------------------

def read_events() -> list[dict]:
    path = ledger_path()
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise Unreadable(f"{path}: {exc.strerror or exc}")
    events = []
    for n, line in enumerate(lines, 1):
        if not line.strip():
            continue
        try:
            event = json.loads(line)
        except ValueError:
            raise Unreadable(f"{path}:{n}: malformed ledger line")
        if not isinstance(event, dict):
            raise Unreadable(f"{path}:{n}: malformed ledger line")
        if event.get("v") != VERSION:
            continue
        events.append(event)
    return events


def touches(repos: list[str] | None, days: int) -> int:
    since = datetime.now(timezone.utc) - timedelta(days=days)
    events = read_events()
    wanted = set(repos) if repos else None
    lifecycle_by_pr: dict[tuple[str, int], dict] = {}
    stops_by_pr: dict[tuple[str, int], list[str]] = {}
    seen_repos: set[str] = set()
    for e in events:
        subject = e["subject"]
        repo, pr = subject["repo"], subject["pr"]
        if wanted is not None and repo not in wanted:
            continue
        data = e["data"]
        if e["kind"] == "outcome" and data.get("proxy") == PR_PROXY:
            seen_repos.add(repo)
            lifecycle_by_pr[(repo, pr)] = e
        elif e["kind"] == "decision" and data.get("action") == HUMAN_STOP_ACTION:
            seen_repos.add(repo)
            stop = data.get("stop")
            if not isinstance(stop, str):
                raise Unreadable(f"human_stop decision {e.get('id')!r} missing stop name")
            stops_by_pr.setdefault((repo, pr), []).append(stop)

    merged_by_repo: dict[str, list[int]] = {}
    for (repo, pr), e in lifecycle_by_pr.items():
        data = e["data"]
        ended = data.get("merged_at") or e.get("at")
        if data.get("state") == "merged" and ended and parse_time(ended) >= since:
            merged_by_repo.setdefault(repo, []).append(pr)

    order = list(dict.fromkeys(repos)) if repos else sorted(seen_repos)
    print(f"window {since.isoformat(timespec='seconds')} to now ({days} days)")
    for repo in order:
        merged_prs = merged_by_repo.get(repo, [])
        counts: Counter[str] = Counter()
        for pr in merged_prs:
            counts.update(stops_by_pr.get((repo, pr), ()))
        total_stops = sum(counts.values())
        ratio = f"{total_stops / len(merged_prs):.2f}" if merged_prs else "-"
        print(f"{repo}: merged {len(merged_prs)}  human stops {total_stops}"
              f"  touches/merged PR {ratio}  by stop {dict(sorted(counts.items()))}")
    return EXIT_OK


# --- entry ---------------------------------------------------------------

def repo_arg(value: str) -> str:
    if not REPO_RE.match(value):
        raise argparse.ArgumentTypeError("must be OWNER/NAME")
    return value


def days_arg(value: str) -> int:
    if not value.isdigit() or int(value) < 1:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return int(value)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="guild-ledger", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("append", help="append one event read from stdin")
    bf = sub.add_parser("backfill", help="join posted council findings to GitHub")
    bf.add_argument("--council-dir", default=council_default())
    bp = sub.add_parser("backfill-prs", help="record each merged or closed PR's lifecycle from GitHub")
    bp.add_argument("--repo", action="append", required=True, type=repo_arg, metavar="OWNER/NAME")
    bp.add_argument("--days", type=days_arg, default=30)
    rf = sub.add_parser("refresh", help="run both backfills and ping on a failure (the daily timer)")
    rf.add_argument("--council-dir", default=council_default())
    tc = sub.add_parser("touches", help="human touches per merged PR from the ledger alone")
    tc.add_argument("--repo", action="append", type=repo_arg, metavar="OWNER/NAME")
    tc.add_argument("--days", type=days_arg, default=TOUCHES_DAYS)
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:
        return EXIT_BAD_EVENT if exc.code else EXIT_OK
    try:
        if args.cmd == "append":
            try:
                event = validate(json.loads(sys.stdin.read()))
            except ValueError as exc:
                raise BadEvent(f"not JSON: {exc}")
            new = append_events([event])[0]
            print(f"{'appended' if new else 'exists'} {event['id']}")
            return EXIT_OK
        if args.cmd == "refresh":
            return refresh(Path(args.council_dir))
        try:
            if args.cmd == "touches":
                return touches(args.repo, args.days)
            if args.cmd == "backfill-prs":
                return backfill_prs(list(dict.fromkeys(args.repo)), args.days)
            return backfill(Path(args.council_dir))
        except SHAPE_ERRORS as exc:
            raise Unreadable(f"unexpected shape in a council run or GitHub response: {exc!r}")
    except BadEvent as exc:
        print(f"guild-ledger: malformed event: {exc}", file=sys.stderr)
        return EXIT_BAD_EVENT
    except Unreadable as exc:
        print(f"guild-ledger: {exc}", file=sys.stderr)
        return EXIT_UNREADABLE


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
