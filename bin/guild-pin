#!/usr/bin/env python3
"""Move member pins to each member's trunk head, so a Guild release carries merged work.

usage: guild-pin [--apply] [--auto] [--resume PR_URL] [MEMBER ...]

Reads tests/member-pins.json from origin's main of this Guild checkout. For each
member (default: every pinned member) it reads the head of the member's default
branch on GitHub. A head moves the pin only when every check run on it passed;
a head with a pending or failed run keeps the old pin and is reported. A member
with no check runs at all moves when Actions is enabled. When Actions is
disabled, no check runs alone is not enough: a passed local-test record for that
exact tree is required (unsupported members without a local-test suite stay
blocked). Local-test evidence (`guild-local-test run`) never overrides a genuine
CI failure; it may clear only the known Actions billing failure annotation.
Local-test is not GitHub CI.

Without --apply it prints the plan and changes nothing. With --apply it commits
the new pins on a branch in a temporary worktree. When Actions is disabled it
runs local-test on that exact candidate before creating the PR, then merges when
evidence matches. When Actions is enabled it opens the PR and waits for Guild CI.
`--resume PR_URL` runs local-test on an existing pin PR candidate (if needed) and
merges when evidence covers its tree+pins.

With --auto (for systemd timers), it implies --apply, acquires an flock, closes
any conflicting pin/* PR, and if another open pin/* PR exists tries to merge it
only when local-test evidence already covers that candidate (it does not run
suites from the timer). Exits 0 while member checks are still pending, retries
fetch errors quietly until the eighth in a row, and sends one `job-notify --send`
ping per failure key.
"""
from __future__ import annotations

import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(Path(__file__).resolve().parent))
import guild_local_test as local_test  # noqa: E402

PINS_PATH = "tests/member-pins.json"
# Fetch into a ref only this script writes: guild-host-sync fetches origin/main in this checkout on its own timer,
# and two fetches into one ref fail with "cannot lock ref".
MAIN_REF = "refs/guild-pin/main"
PASSED = {"success", "skipped", "neutral"}
CHECKS_APPEAR_TRIES = 60
CHECKS_APPEAR_SECONDS = 5
TRANSIENT_LIMIT = 8


@dataclass
class Move:
    member: str
    old: str
    new: str
    tree: str = ""
    blocked: str = ""
    pending: bool = False
    unchecked: bool = False
    local_test: bool = False
    subjects: list[str] = field(default_factory=list)


def sh(*cmd: str, cwd: Path = ROOT) -> str:
    out = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    if out.returncode != 0:
        raise RuntimeError(f"guild-pin: {' '.join(cmd)} failed: {out.stderr.strip()}")
    return out.stdout.strip()


def repo_slug() -> str:
    url = sh("git", "config", "--get", "remote.origin.url")
    m = re.search(r"github\.com[:/]+([^/]+/[^/]+?)(?:\.git)?$", url)
    if not m:
        raise RuntimeError(f"guild-pin: origin is not on GitHub: {url}")
    return m.group(1)


def owner() -> str:
    return repo_slug().split("/", 1)[0]


def pin_state_dir() -> Path:
    env = os.environ.get("GUILD_PIN_STATE_DIR")
    if env:
        return Path(env)
    xdg = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(xdg) / "guild" / "pin-state"


def notify_once(state_dir: Path, key: str, message: str) -> None:
    pinged_dir = state_dir / "pinged"
    pinged_dir.mkdir(parents=True, exist_ok=True)
    safe_key = re.sub(r"[^A-Za-z0-9._-]", "_", key)
    marker = pinged_dir / safe_key
    if marker.exists():
        return
    marker.touch()
    jn = shutil.which("job-notify")
    if not jn:
        print("guild-pin: job-notify not on PATH", file=sys.stderr)
        return
    clean = "".join(ch for ch in message if ch.isprintable() and ch not in '\\"')
    done = subprocess.run([jn, "--send", str(state_dir.parent), "guild-pin", "FAILED", clean],
                          capture_output=True, text=True)
    if done.returncode != 0:
        print("guild-pin: job-notify failed", file=sys.stderr)


def clear_pings(state_dir: Path) -> None:
    pinged_dir = state_dir / "pinged"
    if not pinged_dir.is_dir():
        return
    for p in pinged_dir.iterdir():
        p.unlink(missing_ok=True)


def clear_fetch_streak(state_dir: Path) -> None:
    (state_dir / "transient").unlink(missing_ok=True)
    (state_dir / "pinged" / "streak").unlink(missing_ok=True)


def transient_fetch(state_dir: Path, message: str) -> int:
    transient_file = state_dir / "transient"
    try:
        n = int(transient_file.read_text(encoding="utf-8").strip()) + 1
    except (OSError, ValueError):
        n = 1
    transient_file.write_text(f"{n}\n", encoding="utf-8")
    if n >= TRANSIENT_LIMIT:
        streak_msg = f"{message} ({TRANSIENT_LIMIT} or more runs in a row)"
        print(streak_msg, file=sys.stderr)
        notify_once(state_dir, "streak", streak_msg)
        return 1
    print(f"{message}; will retry", file=sys.stderr)
    return 0


def open_pin_prs(slug: str) -> list[dict[str, object]]:
    raw = sh("gh", "pr", "list", "--repo", slug, "--state", "open",
             "--json", "number,headRefName,url,mergeable,isCrossRepository")
    prs = json.loads(raw or "[]")
    return [p for p in prs if not p.get("isCrossRepository") and str(p.get("headRefName", "")).startswith("pin/")]


def delete_remote_branch(branch: str) -> None:
    done = subprocess.run(["git", "push", "-q", "origin", "--delete", branch],
                          cwd=ROOT, capture_output=True, text=True)
    if done.returncode != 0 and sh("git", "ls-remote", "--heads", "origin", f"refs/heads/{branch}"):
        raise RuntimeError(f"guild-pin: git push -q origin --delete {branch} failed: {done.stderr.strip()}")


def close_pin_pr(pr: dict[str, object]) -> None:
    url, branch = str(pr["url"]), str(pr["headRefName"])
    sh("gh", "pr", "close", url)
    print(f"guild-pin: closed conflicting pin PR {url}")
    delete_remote_branch(branch)


def plan(org: str, pins: dict[str, str], members: list[str]) -> list[Move]:
    moves = []
    for member in members:
        old = pins[member]
        new = sh("gh", "api", f"repos/{org}/{member}/commits/HEAD", "--jq", ".sha")
        if new == old:
            continue
        tree = sh("gh", "api", f"repos/{org}/{member}/commits/{new}", "--jq", ".commit.tree.sha")
        repo = f"{org}/{member}"
        move = Move(member, old, new, tree=tree)
        runs = json.loads(sh(
            "gh", "api", f"repos/{org}/{member}/commits/{new}/check-runs",
            "--jq", "[.check_runs[] | {id, name, status, conclusion}]",
        ))
        bad = [r for r in runs if r["status"] != "completed" or r["conclusion"] not in PASSED]
        local_ok = local_test.accepts(
            repo, sha=new, tree=tree, pins=None, require_passed=True,
        ) is not None
        local_fail = local_test.accepts(
            repo, sha=new, tree=tree, pins=None, require_passed=False,
        )
        local_fail = bool(local_fail and local_fail["status"] == "failed")
        actions_on = local_test.actions_enabled(repo)
        if local_fail:
            move.blocked = "local-test failed"
        elif not bad:
            if runs:
                move.local_test = False
            elif actions_on:
                move.unchecked = True
            elif local_ok:
                move.local_test = True
            else:
                move.blocked = "actions disabled; need local-test for this tree"
        elif local_test.only_billing_failures(repo, bad) and local_ok:
            move.local_test = True
        elif local_test.only_billing_failures(repo, bad) and not local_ok:
            move.blocked = "billing-blocked check; need local-test for this tree"
            move.pending = False
        else:
            move.blocked = ", ".join(f"{r['name']} {r['conclusion'] or r['status']}" for r in bad)
            move.pending = all(r["status"] != "completed" for r in bad)
        move.subjects = sh("gh", "api", f"repos/{org}/{member}/compare/{old}...{new}", "--jq",
                           '.commits[] | .sha[0:7] + " " + (.commit.message | split("\\n")[0])').splitlines()
        moves.append(move)
    return moves


def report(org: str, moves: list[Move]) -> str:
    lines = []
    for m in moves:
        if m.blocked:
            state = f"blocked: {m.blocked}"
        elif m.local_test:
            state = "local-test passed"
        elif m.unchecked:
            state = "no check runs"
        else:
            state = "checks passed"
        lines.append(f"- **{m.member}** {m.old[:7]} -> {m.new[:7]} ({state})")
        lines += [f"  - [{s[:7]}](https://github.com/{org}/{m.member}/commit/{s[:7]}){s[7:]}" for s in m.subjects]
    return "\n".join(lines)


def candidate_identity(cwd: Path, pins: dict[str, str]) -> tuple[str, str, dict[str, str]]:
    """Tree and pins from the pin-candidate checkout (not the installed main)."""
    head = local_test.git(Path(cwd), "rev-parse", "HEAD")
    tree = local_test.git(Path(cwd), "rev-parse", "HEAD^{tree}")
    pins_here = local_test.load_pins(Path(cwd) / PINS_PATH)
    want = {k: local_test.normalize_sha(v) for k, v in pins.items()}
    if pins_here != want:
        raise RuntimeError("guild-pin: candidate pins file does not match the planned pins")
    return head, tree, pins_here


def ci_passed(url: str, cwd: Path, pins: dict[str, str]) -> bool:
    """Accept Guild CI, or local-test for this candidate tree+pins when Actions is off."""
    slug = repo_slug()
    head, tree, pins_here = candidate_identity(cwd, pins)
    local_ok = local_test.accepts(
        slug, sha=head, tree=tree, pins=pins_here, require_passed=True,
    ) is not None
    actions_on = local_test.actions_enabled(slug)
    if not actions_on:
        return local_ok
    # Actions on: local-test never skips real CI / pending checks.
    for _ in range(CHECKS_APPEAR_TRIES):
        out = subprocess.run(["gh", "pr", "checks", url, "--json", "name"], cwd=cwd, capture_output=True, text=True)
        try:
            if json.loads(out.stdout or "[]"):
                break
        except json.JSONDecodeError:
            pass
        time.sleep(CHECKS_APPEAR_SECONDS)
    else:
        return False
    return subprocess.run(["gh", "pr", "checks", url, "--watch", "--fail-fast"], cwd=cwd).returncode == 0


def merge_if_ready(url: str, cwd: Path, pins: dict[str, str]) -> None:
    if not ci_passed(url, cwd, pins):
        raise RuntimeError(
            f"guild-pin: Guild CI did not pass on {url}, and no passed local-test "
            f"record covers its head tree and pins; not merged. "
            f"When Actions is off: guild-local-test run --checkout <candidate> "
            f"then guild-pin --resume {url}"
        )
    sh("gh", "pr", "merge", url, "--merge", cwd=cwd)
    print(f"guild-pin: merged {url}")


def apply(org: str, pins: dict[str, str], ready: list[Move], *, replace_orphan: bool = False) -> None:
    for m in ready:
        pins[m.member] = m.new
    names = " and ".join(f"{m.member} {m.new[:7]}" for m in ready)
    title = f"Pin {names} at trunk"
    branch = "pin/" + "-".join(f"{m.member}-{m.new[:7]}" for m in ready)
    merged = False
    with tempfile.TemporaryDirectory(prefix="guild-pin-") as tmp:
        wt = Path(tmp) / "wt"
        sh("git", "worktree", "add", "-q", "-b", branch, str(wt), MAIN_REF)
        try:
            (wt / PINS_PATH).write_text(json.dumps(pins, indent=2) + "\n", encoding="utf-8")
            sh("git", "commit", "-q", "-am", title, cwd=wt)
            actions_on = local_test.actions_enabled(repo_slug())
            if not actions_on:
                # Run the exact candidate suite before opening a PR so --auto is not stuck.
                print("guild-pin: Actions disabled; running local-test on pin candidate", file=sys.stderr)
                rec = local_test.run(checkout=wt)
                if rec["status"] != "passed":
                    raise RuntimeError(
                        "guild-pin: local-test failed on pin candidate; not creating PR"
                    )
            if replace_orphan and sh("git", "ls-remote", "--heads", "origin", f"refs/heads/{branch}"):
                delete_remote_branch(branch)
            sh("git", "push", "-q", "-u", "origin", branch, cwd=wt)
            body = "## Why\nShip merged member work to the Surface release.\n\n## Pins\n" + report(org, ready)
            url = sh("gh", "pr", "create", "--base", "main", "--head", branch, "--title", title, "--body", body, cwd=wt)
            print(url)
            merge_if_ready(url, wt, pins)
            merged = True
        finally:
            subprocess.run(["git", "worktree", "remove", "--force", str(wt)], cwd=ROOT, capture_output=True)
            cmds = [["git", "branch", "-q", "-D", branch]]
            if merged:
                cmds.insert(0, ["git", "push", "-q", "origin", "--delete", branch])
            for cmd in cmds:
                done = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)
                if done.returncode != 0:
                    print(f"guild-pin: left branch {branch} behind: {done.stderr.strip()}", file=sys.stderr)


def resume_pin_pr(url: str, *, run_suite: bool = True) -> None:
    """Merge an existing pin PR when local-test covers its exact tree+pins (Actions off)."""
    slug = repo_slug()
    actions_on = local_test.actions_enabled(slug)
    meta = json.loads(sh("gh", "pr", "view", url, "--json", "headRefOid,headRefName,url"))
    head = meta["headRefOid"]
    branch = meta["headRefName"]
    with tempfile.TemporaryDirectory(prefix="guild-pin-resume-") as tmp:
        wt = Path(tmp) / "wt"
        sh("git", "fetch", "-q", "origin", head)
        sh("git", "worktree", "add", "-q", "--detach", str(wt), head)
        try:
            pins = local_test.load_pins(wt / PINS_PATH)
            head_sha, tree, pins_here = candidate_identity(wt, pins)
            if local_test.accepts(
                slug, sha=head_sha, tree=tree, pins=pins_here, require_passed=True,
            ) is None:
                if actions_on:
                    raise RuntimeError(
                        f"guild-pin: Actions is enabled; use Guild CI on {url}, not --resume"
                    )
                if not run_suite:
                    raise RuntimeError(
                        f"guild-pin: no local-test evidence for {url} tree {tree}; "
                        f"run guild-local-test run --checkout <candidate> then --resume"
                    )
                print("guild-pin: running local-test on existing pin PR candidate", file=sys.stderr)
                rec = local_test.run(checkout=wt)
                if rec["status"] != "passed":
                    raise RuntimeError(f"guild-pin: local-test failed for {url}; not merged")
            merge_if_ready(url, wt, pins_here)
            if branch.startswith("pin/"):
                done = subprocess.run(
                    ["git", "push", "-q", "origin", "--delete", branch],
                    cwd=ROOT, capture_output=True, text=True,
                )
                if done.returncode != 0:
                    print(f"guild-pin: left branch {branch} behind: {done.stderr.strip()}", file=sys.stderr)
        finally:
            subprocess.run(["git", "worktree", "remove", "--force", str(wt)], cwd=ROOT, capture_output=True)


def main(argv: list[str]) -> int:
    do_auto = "--auto" in argv
    do_apply = do_auto or ("--apply" in argv)
    resume_url = None
    if "--resume" in argv:
        i = argv.index("--resume")
        if i + 1 >= len(argv) or argv[i + 1].startswith("-"):
            print("guild-pin: --resume needs a PR URL", file=sys.stderr)
            return 2
        resume_url = argv[i + 1]
    names = [
        a for a in argv
        if a not in ("--apply", "--auto", "--resume", resume_url)
    ]
    if any(a.startswith("-") for a in names):
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        return 2

    if resume_url and (do_auto or do_apply or names):
        print("guild-pin: --resume cannot combine with --apply/--auto/members", file=sys.stderr)
        return 2

    lock_file = None
    state_dir = pin_state_dir() if do_auto else None
    if state_dir is not None:
        state_dir.mkdir(parents=True, exist_ok=True)
        lock_file = open(state_dir / "lock", "w", encoding="utf-8")
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print("guild-pin: another run is in progress", file=sys.stderr)
            return 0

    try:
        if resume_url:
            resume_pin_pr(resume_url, run_suite=True)
            return 0
        try:
            sh("git", "fetch", "-q", "--no-write-fetch-head", "--refmap=", "origin", f"+refs/heads/main:{MAIN_REF}")
        except RuntimeError as exc:
            if state_dir is not None:
                return transient_fetch(state_dir, str(exc))
            raise
        if state_dir is not None:
            clear_fetch_streak(state_dir)
        pins = json.loads(sh("git", "show", f"{MAIN_REF}:{PINS_PATH}"))
        unknown = [n for n in names if n not in pins]
        if unknown:
            raise RuntimeError(f"guild-pin: not a pinned member: {', '.join(unknown)}")
        org = owner()
        if do_auto:
            existing = []
            for pr in open_pin_prs(repo_slug()):
                if pr.get("mergeable") == "CONFLICTING":
                    close_pin_pr(pr)
                else:
                    existing.append(pr)
            if existing:
                url = existing[0]["url"]
                # Resume only when evidence already covers the PR (timer must not run suites).
                try:
                    resume_pin_pr(url, run_suite=False)
                    if state_dir is not None:
                        clear_pings(state_dir)
                    return 0
                except RuntimeError as exc:
                    print(f"guild-pin: open pin PR already exists: {url} ({exc})")
                    return 0
        moves = plan(org, pins, names or list(pins))
        if not moves:
            print("guild-pin: every pin is at its member's trunk head")
            if state_dir is not None:
                clear_pings(state_dir)
            return 0
        print(report(org, moves))
        ready = [m for m in moves if not m.blocked]
        if do_apply and ready:
            apply(org, pins, ready, replace_orphan=do_auto)
        failed = [m for m in moves if m.blocked and not m.pending]
        pending = [m for m in moves if m.blocked and m.pending]
        if state_dir is not None:
            for m in failed:
                notify_once(state_dir, f"member-{m.member}-{m.new[:12]}",
                            f"{m.member} {m.new[:7]} blocked: {m.blocked}")
            if not failed and not pending:
                clear_pings(state_dir)
            if not failed:
                return 0
        return 1 if any(m.blocked for m in moves) else 0
    except RuntimeError as exc:
        msg = str(exc)
        print(msg, file=sys.stderr)
        if state_dir is not None:
            notify_once(state_dir, "run", msg)
        return 1
    finally:
        if lock_file is not None:
            lock_file.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
