#!/usr/bin/env python3
"""Move member pins to each member's trunk head, so a Guild release carries merged work.

usage: guild-pin [--apply] [--auto] [MEMBER ...]

Reads tests/member-pins.json from origin's main of this Guild checkout. For each
member (default: every pinned member) it reads the head of the member's default
branch on GitHub. A head moves the pin when every check run on it passed, or
when a `local-tests` success status sits on that exact commit (guild-local-pass
posts it, for when GitHub Actions is off). Any other head keeps the old pin and
is reported, a head with no check runs included.

Without --apply it prints the plan and changes nothing. With --apply it commits
the new pins on a branch in a temporary worktree, opens a pull request whose body
lists the commits each pin carries, waits for Guild CI, and merges it. The
Surface updater then installs the release on its own. Exit 0 with nothing to move.
A PR that gets no checks within five minutes stays open for a local pass.

With --auto (for systemd timers), it implies --apply, acquires an flock, closes
any conflicting pin/* PR, merges an open pin/* PR whose checks have passed and
otherwise skips while one is open, exits 0 while member checks are still pending,
retries fetch errors quietly until the eighth in a row, and sends one
`job-notify --send` ping per failure key.
"""
from __future__ import annotations

import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PINS_PATH = "tests/member-pins.json"
# Fetch into a ref only this script writes: guild-host-sync fetches origin/main in this checkout on its own timer,
# and two fetches into one ref fail with "cannot lock ref".
MAIN_REF = "refs/guild-pin/main"
PASSED = {"success", "skipped", "neutral"}
# Tests shorten the wait for checks to appear.
CHECKS_APPEAR_TRIES = int(os.environ.get("GUILD_PIN_CHECK_TRIES") or 60)
CHECKS_APPEAR_SECONDS = 5
TRANSIENT_LIMIT = 8
LOCAL_CONTEXT = "local-tests"


@dataclass
class Move:
    member: str
    old: str
    new: str
    blocked: str = ""
    pending: bool = False
    local: bool = False
    subjects: list[str] = field(default_factory=list)


def sh(*cmd: str, cwd: Path = ROOT) -> str:
    out = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    if out.returncode != 0:
        raise RuntimeError(f"guild-pin: {' '.join(cmd)} failed: {out.stderr.strip()}")
    return out.stdout.strip()


def repo_slug() -> str:
    url = sh("git", "config", "--get", "remote.origin.url")
    m = re.search(r"github\.com[:/]+([^/]+/[^/]+?)(?:\.git)?$", url)
    if not m:
        raise RuntimeError(f"guild-pin: origin is not on GitHub: {url}")
    return m.group(1)


def owner() -> str:
    return repo_slug().split("/", 1)[0]


def pin_state_dir() -> Path:
    env = os.environ.get("GUILD_PIN_STATE_DIR")
    if env:
        return Path(env)
    xdg = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(xdg) / "guild" / "pin-state"


def notify_once(state_dir: Path, key: str, message: str) -> None:
    pinged_dir = state_dir / "pinged"
    pinged_dir.mkdir(parents=True, exist_ok=True)
    safe_key = re.sub(r"[^A-Za-z0-9._-]", "_", key)
    marker = pinged_dir / safe_key
    if marker.exists():
        return
    marker.touch()
    jn = shutil.which("job-notify")
    if not jn:
        print("guild-pin: job-notify not on PATH", file=sys.stderr)
        return
    clean = "".join(ch for ch in message if ch.isprintable() and ch not in '\\"')
    done = subprocess.run([jn, "--send", str(state_dir.parent), "guild-pin", "FAILED", clean],
                          capture_output=True, text=True)
    if done.returncode != 0:
        print("guild-pin: job-notify failed", file=sys.stderr)


def clear_pings(state_dir: Path) -> None:
    pinged_dir = state_dir / "pinged"
    if not pinged_dir.is_dir():
        return
    for p in pinged_dir.iterdir():
        p.unlink(missing_ok=True)


def clear_fetch_streak(state_dir: Path) -> None:
    (state_dir / "transient").unlink(missing_ok=True)
    (state_dir / "pinged" / "streak").unlink(missing_ok=True)


def transient_fetch(state_dir: Path, message: str) -> int:
    transient_file = state_dir / "transient"
    try:
        n = int(transient_file.read_text(encoding="utf-8").strip()) + 1
    except (OSError, ValueError):
        n = 1
    transient_file.write_text(f"{n}\n", encoding="utf-8")
    if n >= TRANSIENT_LIMIT:
        streak_msg = f"{message} ({TRANSIENT_LIMIT} or more runs in a row)"
        print(streak_msg, file=sys.stderr)
        notify_once(state_dir, "streak", streak_msg)
        return 1
    print(f"{message}; will retry", file=sys.stderr)
    return 0


def open_pin_prs(slug: str) -> list[dict[str, object]]:
    raw = sh("gh", "pr", "list", "--repo", slug, "--state", "open",
             "--json", "number,headRefName,headRefOid,url,mergeable,isCrossRepository")
    prs = json.loads(raw or "[]")
    return [p for p in prs if not p.get("isCrossRepository") and str(p.get("headRefName", "")).startswith("pin/")]


def delete_remote_branch(branch: str) -> None:
    done = subprocess.run(["git", "push", "-q", "origin", "--delete", branch],
                          cwd=ROOT, capture_output=True, text=True)
    if done.returncode != 0 and sh("git", "ls-remote", "--heads", "origin", f"refs/heads/{branch}"):
        raise RuntimeError(f"guild-pin: git push -q origin --delete {branch} failed: {done.stderr.strip()}")


def close_pin_pr(pr: dict[str, object]) -> None:
    url, branch = str(pr["url"]), str(pr["headRefName"])
    sh("gh", "pr", "close", url)
    print(f"guild-pin: closed conflicting pin PR {url}")
    delete_remote_branch(branch)


def plan(org: str, pins: dict[str, str], members: list[str]) -> list[Move]:
    moves = []
    for member in members:
        old = pins[member]
        new = sh("gh", "api", f"repos/{org}/{member}/commits/HEAD", "--jq", ".sha")
        if new == old:
            continue
        move = Move(member, old, new)
        runs = json.loads(sh("gh", "api", f"repos/{org}/{member}/commits/{new}/check-runs",
                             "--jq", "[.check_runs[] | {name, status, conclusion}]"))
        bad = [r for r in runs if r["status"] != "completed" or r["conclusion"] not in PASSED]
        if bad or not runs:
            if local_passed(f"{org}/{member}", new):
                move.local = True
            else:
                move.blocked = (", ".join(f"{r['name']} {r['conclusion'] or r['status']}" for r in bad)
                                or "no check runs or local pass")
                move.pending = all(r["status"] != "completed" for r in bad)
        move.subjects = sh("gh", "api", f"repos/{org}/{member}/compare/{old}...{new}", "--jq",
                           '.commits[] | .sha[0:7] + " " + (.commit.message | split("\\n")[0])').splitlines()
        moves.append(move)
    return moves


def local_passed(slug: str, sha: str) -> bool:
    # The combined status holds the newest status per context, so a later failure replaces a pass.
    state = sh("gh", "api", f"repos/{slug}/commits/{sha}/status", "--jq",
               f'[.statuses[] | select(.context == "{LOCAL_CONTEXT}") | .state] | first // ""')
    return state == "success"


def report(org: str, moves: list[Move]) -> str:
    lines = []
    for m in moves:
        state = f"blocked: {m.blocked}" if m.blocked else ("local tests passed" if m.local else "checks passed")
        lines.append(f"- **{m.member}** {m.old[:7]} -> {m.new[:7]} ({state})")
        lines += [f"  - [{s[:7]}](https://github.com/{org}/{m.member}/commit/{s[:7]}){s[7:]}" for s in m.subjects]
    return "\n".join(lines)


def ci_passed(url: str, cwd: Path) -> bool | None:
    """Whether the PR's checks passed, or None when none appeared: with Actions off, a local pass comes later."""
    # A PR opened seconds ago has no check runs yet, and `gh pr checks --watch` exits 1 on that.
    for _ in range(CHECKS_APPEAR_TRIES):
        out = subprocess.run(["gh", "pr", "checks", url, "--json", "name"], cwd=cwd, capture_output=True, text=True)
        try:
            if json.loads(out.stdout or "[]"):
                break
        except json.JSONDecodeError:
            pass
        time.sleep(CHECKS_APPEAR_SECONDS)
    else:
        return None
    return subprocess.run(["gh", "pr", "checks", url, "--watch", "--fail-fast"], cwd=cwd).returncode == 0


def checks_passed_now(url: str) -> bool:
    """Whether every check and status on the PR head has passed; none at all is not a pass."""
    out = subprocess.run(["gh", "pr", "checks", url, "--json", "bucket"], cwd=ROOT, capture_output=True, text=True)
    try:
        buckets = {c["bucket"] for c in json.loads(out.stdout or "[]")}
    except (json.JSONDecodeError, TypeError, KeyError):
        return False
    return bool(buckets) and buckets <= {"pass", "skipping"}


def apply(org: str, pins: dict[str, str], ready: list[Move], *, replace_orphan: bool = False) -> None:
    for m in ready:
        pins[m.member] = m.new
    names = " and ".join(f"{m.member} {m.new[:7]}" for m in ready)
    title = f"Pin {names} at trunk"
    branch = "pin/" + "-".join(f"{m.member}-{m.new[:7]}" for m in ready)
    merged = False
    with tempfile.TemporaryDirectory(prefix="guild-pin-") as tmp:
        wt = Path(tmp) / "wt"
        sh("git", "worktree", "add", "-q", "-b", branch, str(wt), MAIN_REF)
        try:
            (wt / PINS_PATH).write_text(json.dumps(pins, indent=2) + "\n", encoding="utf-8")
            sh("git", "commit", "-q", "-am", title, cwd=wt)
            if replace_orphan and sh("git", "ls-remote", "--heads", "origin", f"refs/heads/{branch}"):
                delete_remote_branch(branch)
            sh("git", "push", "-q", "-u", "origin", branch, cwd=wt)
            body = "## Why\nShip merged member work to the Surface release.\n\n## Pins\n" + report(org, ready)
            url = sh("gh", "pr", "create", "--base", "main", "--head", branch, "--title", title, "--body", body, cwd=wt)
            print(url)
            passed = ci_passed(url, wt)
            if passed is None:
                print(f"guild-pin: no checks on {url}; a later run merges it once its checks or a local pass succeed")
                return
            if not passed:
                raise RuntimeError(f"guild-pin: Guild CI did not pass on {url}; not merged")
            # --match-head-commit: merge only the commit whose checks were read.
            sh("gh", "pr", "merge", url, "--merge", "--match-head-commit", sh("git", "rev-parse", "HEAD", cwd=wt), cwd=wt)
            merged = True
            print(f"guild-pin: merged {url}")
        finally:
            subprocess.run(["git", "worktree", "remove", "--force", str(wt)], cwd=ROOT, capture_output=True)
            # The local branch always goes: a failed run that kept it made every later run fail on `worktree add -b`.
            # Not gh's --delete-branch: it checks out main here, which fails when another worktree holds main.
            cmds = [["git", "branch", "-q", "-D", branch]]
            if merged:
                cmds.insert(0, ["git", "push", "-q", "origin", "--delete", branch])
            for cmd in cmds:
                done = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)
                if done.returncode != 0:
                    print(f"guild-pin: left branch {branch} behind: {done.stderr.strip()}", file=sys.stderr)


def main(argv: list[str]) -> int:
    do_auto = "--auto" in argv
    do_apply = do_auto or ("--apply" in argv)
    names = [a for a in argv if a not in ("--apply", "--auto")]
    if any(a.startswith("-") for a in names):
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        return 2

    lock_file = None
    state_dir = pin_state_dir() if do_auto else None
    if state_dir is not None:
        state_dir.mkdir(parents=True, exist_ok=True)
        lock_file = open(state_dir / "lock", "w", encoding="utf-8")
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print("guild-pin: another run is in progress", file=sys.stderr)
            return 0

    try:
        try:
            sh("git", "fetch", "-q", "--no-write-fetch-head", "--refmap=", "origin", f"+refs/heads/main:{MAIN_REF}")
        except RuntimeError as exc:
            if state_dir is not None:
                return transient_fetch(state_dir, str(exc))
            raise
        if state_dir is not None:
            clear_fetch_streak(state_dir)
        pins = json.loads(sh("git", "show", f"{MAIN_REF}:{PINS_PATH}"))
        unknown = [n for n in names if n not in pins]
        if unknown:
            raise RuntimeError(f"guild-pin: not a pinned member: {', '.join(unknown)}")
        org = owner()
        if do_auto:
            existing = []
            for pr in open_pin_prs(repo_slug()):
                if pr.get("mergeable") == "CONFLICTING":
                    close_pin_pr(pr)
                else:
                    existing.append(pr)
            if existing:
                pr = existing[0]
                if not checks_passed_now(str(pr["url"])):
                    print(f"guild-pin: open pin PR already exists: {pr['url']}")
                    return 0
                sh("gh", "pr", "merge", str(pr["url"]), "--merge", "--match-head-commit", str(pr["headRefOid"]))
                delete_remote_branch(str(pr["headRefName"]))
                print(f"guild-pin: merged {pr['url']}")
                return 0
        moves = plan(org, pins, names or list(pins))
        if not moves:
            print("guild-pin: every pin is at its member's trunk head")
            if state_dir is not None:
                clear_pings(state_dir)
            return 0
        print(report(org, moves))
        ready = [m for m in moves if not m.blocked]
        if do_apply and ready:
            apply(org, pins, ready, replace_orphan=do_auto)
        failed = [m for m in moves if m.blocked and not m.pending]
        pending = [m for m in moves if m.blocked and m.pending]
        if state_dir is not None:
            for m in failed:
                notify_once(state_dir, f"member-{m.member}-{m.new[:12]}",
                            f"{m.member} {m.new[:7]} blocked: {m.blocked}")
            if not failed and not pending:
                clear_pings(state_dir)
            if not failed:
                return 0
        return 1 if any(m.blocked for m in moves) else 0
    except RuntimeError as exc:
        msg = str(exc)
        print(msg, file=sys.stderr)
        if state_dir is not None:
            notify_once(state_dir, "run", msg)
        return 1
    finally:
        if lock_file is not None:
            lock_file.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
