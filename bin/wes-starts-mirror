#!/usr/bin/env bash
# wes-starts-mirror: write the box mirror of the Surface review-start ledger for work-review-requests-check.sh
# (Paul re-verify 2026-11-09 17:40, point 1). Read-only on the Surface: the input is the stdout of the Surface
# extract (~/work-notes/state/wes-starts.log review lines reduced to "<job name>[ head=<sha>]", then
# "# end lines=N"), saved to a box file by the caller.
# Usage: wes-starts-mirror --from EXTRACT_FILE [--out MIRROR]   (default out: fleet/state/wes-starts.mirror.log)
# Writes "# wes-starts-mirror v1 ts=<epoch> sha256=<sha of body> lines=<N>" then the body, atomically.
# Logs every attempt to <out dir>/wes-starts.mirror.shalog: "<PT ts> sha256=<sha> lines=<N> ok" or "... fail <why>".
# Fails closed (exit 4): missing/empty input, no end sentinel, count mismatch, or any line with fields other
# than the job name and head=. On failure the old mirror is removed, so the check cannot use a stale copy.
set -uo pipefail
SRC=""; OUT=/home/box/agent-data/fleet/state/wes-starts.mirror.log
while [ $# -gt 0 ]; do case "$1" in --from) SRC="$2"; shift;; --out) OUT="$2"; shift;; esac; shift; done
mkdir -p "$(dirname "$OUT")"
WSM_SRC="$SRC" WSM_OUT="$OUT" python3 - <<'PY'
import hashlib, os, re, sys, time
from datetime import datetime
from zoneinfo import ZoneInfo
src, out = os.environ["WSM_SRC"], os.environ["WSM_OUT"]
log = os.path.join(os.path.dirname(out), "wes-starts.mirror.shalog")
now = int(os.environ.get("WRRC_NOW") or time.time())
stamp = datetime.fromtimestamp(now, ZoneInfo("America/Los_Angeles")).isoformat(timespec="seconds")
def fail(why, sha="-", n="-"):
    open(log, "a").write(f"{stamp} sha256={sha} lines={n} fail {why}\n")
    try: os.unlink(out)
    except FileNotFoundError: pass
    print(f"wes-starts-mirror: fail {why}", file=sys.stderr); sys.exit(4)
try: raw = open(src).read() if src else ""
except OSError: fail("input unreadable")
rows = raw.splitlines()
if not rows: fail("input empty")
m = re.fullmatch(r"# end lines=([0-9]+)", rows[-1].strip())
if not m: fail("no end sentinel (copy truncated or failed)")
body = rows[:-1]
line_re = re.compile(r"review-[a-z]+(?:-[a-z]+)*-[0-9]+(?:-[A-Za-z0-9-]+)?(?: head=[0-9a-f]{7,40})?")
for l in body:
    if not line_re.fullmatch(l): fail("line with fields other than job name and head=")
if int(m.group(1)) != len(body): fail(f"count mismatch (sentinel {m.group(1)}, got {len(body)})")
text = "".join(l + "\n" for l in body)
sha = hashlib.sha256(text.encode()).hexdigest()
tmp = out + ".tmp"
open(tmp, "w").write(f"# wes-starts-mirror v1 ts={now} sha256={sha} lines={len(body)}\n" + text)
os.replace(tmp, out)
open(log, "a").write(f"{stamp} sha256={sha} lines={len(body)} ok\n")
print(f"wes-starts-mirror: ok sha256={sha} lines={len(body)}")
PY
