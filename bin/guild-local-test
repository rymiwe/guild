#!/usr/bin/env python3
"""Run or inspect exact-commit local-test evidence for Guild release gates.

usage:
  guild-local-test run --checkout PATH
  guild-local-test status --repo OWNER/NAME --sha SHA --tree TREE [--pins FILE]
  guild-local-test export --repo OWNER/NAME --sha SHA
  guild-local-test import < evidence.json

`run` derives the repo from origin, loads guild pins from the checkout when the
repo is guild, checks the workflow digest, and executes that repo's fixed
workflow-equivalent suite. Evidence is bound to the full commit SHA. `import`
accepts only payloads that already bind the full required suite with successful
exit codes (validated transfer). Local-test is not GitHub CI.
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import guild_local_test as lt  # noqa: E402


def _die(msg: str, code: int = 2) -> int:
    print(f"guild-local-test: {msg}", file=sys.stderr)
    return code


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "run":
        checkout = None
        i = 0
        while i < len(rest):
            if rest[i] == "--checkout" and i + 1 < len(rest):
                checkout = rest[i + 1]
                i += 2
            else:
                return _die("run accepts only --checkout PATH")
        if not checkout:
            return _die("run needs --checkout PATH")
        try:
            rec = lt.run(checkout=Path(checkout))
        except (ValueError, RuntimeError, OSError) as exc:
            return _die(str(exc))
        print(json.dumps(
            {"status": rec["status"], "repo": rec["repo"], "sha": rec["sha"],
             "tree": rec["tree"], "suite_id": rec["suite_id"],
             "workflow_digest": rec["workflow_digest"], "authority": rec["authority"]},
            indent=2,
        ))
        return 0 if rec["status"] == "passed" else 1
    if cmd == "status":
        repo = sha = tree = pins_path = None
        i = 0
        while i < len(rest):
            if rest[i] == "--repo" and i + 1 < len(rest):
                repo = rest[i + 1]; i += 2
            elif rest[i] == "--sha" and i + 1 < len(rest):
                sha = rest[i + 1]; i += 2
            elif rest[i] == "--tree" and i + 1 < len(rest):
                tree = rest[i + 1]; i += 2
            elif rest[i] == "--pins" and i + 1 < len(rest):
                pins_path = rest[i + 1]; i += 2
            else:
                return _die("status needs --repo --sha --tree [--pins FILE]")
        if not repo or not sha or not tree:
            return _die("status needs --repo --sha --tree")
        try:
            pins = lt.load_pins(Path(pins_path)) if pins_path else None
            if lt.short_name(repo) == "guild" and pins is None:
                return _die("guild status requires --pins FILE")
            passed = lt.accepts(repo, sha=sha, tree=tree, pins=pins, require_passed=True)
            failed = None if passed else lt.accepts(
                repo, sha=sha, tree=tree, pins=pins, require_passed=False,
            )
        except (ValueError, OSError) as exc:
            return _die(str(exc))
        if passed:
            print("passed")
            return 0
        if failed and failed["status"] == "failed":
            print("failed")
            return 1
        print("missing")
        return 2
    if cmd == "export":
        repo = sha = None
        i = 0
        while i < len(rest):
            if rest[i] == "--repo" and i + 1 < len(rest):
                repo = rest[i + 1]; i += 2
            elif rest[i] == "--sha" and i + 1 < len(rest):
                sha = rest[i + 1]; i += 2
            else:
                return _die("export needs --repo --sha")
        if not repo or not sha:
            return _die("export needs --repo --sha")
        try:
            sys.stdout.write(lt.export_record(repo, sha))
        except (ValueError, FileNotFoundError, OSError) as exc:
            return _die(str(exc))
        return 0
    if cmd == "import":
        try:
            path = lt.import_record(sys.stdin.read())
        except (ValueError, json.JSONDecodeError, OSError) as exc:
            return _die(str(exc))
        print(path)
        return 0
    return _die(f"unknown command {cmd!r}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
