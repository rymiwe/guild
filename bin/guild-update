#!/usr/bin/env bash
# Install the newest Guild release whose exact commit passed CI or local-test.
# guild-update.timer runs it.
#
# usage: guild-update
#
# Each run:
#   1. Fetches the Guild checkout at $GUILD_SRC and reads the commit at origin/HEAD.
#   2. Stops when <root>/installed/g-<sha12> exists: that commit was activated once, and
#      a later hand rollback or switch away from it stands until the next Guild commit.
#      `guild-release prune` never touches installed/. Stops (exit 1) when
#      <root>/failed/g-<sha12> exists: that commit failed to deploy. Delete the file to
#      retry it.
#   3. Accepts the commit when a passed local-test record matches its tree and
#      tests/member-pins.json (local-test is not GitHub CI), or when every push
#      workflow run completed with success/skipped/neutral. Local-test never overrides
#      a failed workflow run while Actions is enabled. When Actions is disabled and
#      there is no finished workflow run, it requires local-test instead of waiting.
#      Otherwise waits (exit 0) while push workflow runs are queued or running, and
#      fails after 24 hours of waiting.
#   4. Exports that commit to a candidate directory, fetches each pinned member under
#      $GUILD_MEMBER_SOURCES_DIR, and runs the candidate's `guild-release deploy` (or
#      `switch`, when an earlier run built the release but did not activate it). A
#      failure writes failed/<id> and leaves the active release and $GUILD_SRC in place.
#   5. On success, records installed/<id>, runs each member's `install.sh --check` against
#      HOME from the new release, restarts the watcher (try-restart: only when it runs),
#      prunes unused releases, and moves $GUILD_SRC to that commit, so a new updater and
#      host guild-exec take effect only with a release that deployed.
#
# Bootstrap: an older installed guild-update that predates local-test cannot read
# evidence. With Actions disabled, activate once by running this script from a
# checkout that already contains it (after importing evidence on that host).
#
# Reporting: a failure exits 1 and sends one `job-notify --send` ping per commit (or per
# error streak). A fetch or GitHub API error is transient and exits 0; from the 8th in a
# row (2 hours at the timer's pace) each run fails. A run that gets past every fetch
# ends a streak. A HOME that fails a member's --check after a switch sends one HOME-LAG
# ping per release and does not fail the run.
#
# Environment:
#   GUILD_RELEASE_ROOT        release root (default ~/.local/share/guild)
#   GUILD_SRC                 Guild checkout the updater runs from (default <root>/src)
#   GUILD_MEMBER_SOURCES_DIR  member checkouts (default ~/code)
#   GUILD_UPDATE_REPO         GitHub owner/repo for CI (default: read from the origin URL)
#   GUILD_UPDATE_RESTART      units to try-restart after a switch (default bopeep-watch.service)
set -euo pipefail

root=${GUILD_RELEASE_ROOT:-$HOME/.local/share/guild}
src=${GUILD_SRC:-$root/src}
sources=${GUILD_MEMBER_SOURCES_DIR:-$HOME/code}
restart_units=${GUILD_UPDATE_RESTART-bopeep-watch.service}
state=$root/update-state
transient_limit=8
wait_limit_s=86400

say() { printf 'guild-update: %s\n' "$*" >&2; }

# ping KEY STATUS MESSAGE: one job-notify ping per KEY. job-notify does not report delivery.
ping() {
  local key=$1 status=$2
  shift 2
  [ ! -e "$state/pinged/$key" ] || return 0
  touch "$state/pinged/$key"
  if command -v job-notify >/dev/null 2>&1; then
    job-notify --send "$root" guild-update "$status" "$(tr -cd '[:print:]' <<<"$*" | tr -d '\\"')" ||
      say "job-notify failed"
  else
    say "job-notify not on PATH"
  fi
}
# fail KEY MESSAGE: exit 1, pinging once per KEY.
fail() {
  local key=$1
  shift
  say "FAILED: $*"
  ping "$key" FAILED "$@"
  exit 1
}
transient() {
  local n
  n=$(( $(cat "$state/transient" 2>/dev/null || echo 0) + 1 ))
  printf '%s\n' "$n" >"$state/transient"
  [ "$n" -lt "$transient_limit" ] || fail streak "$* ($transient_limit or more runs in a row)"
  say "$*; will retry"
  exit 0
}
streak_over() { rm -f "$state/transient" "$state/pinged/streak"; }
all_clear() { streak_over; rm -f "$state/pinged/setup"; }

mkdir -p "$state/pinged" "$root/installed" "$root/failed"
exec 9>"$root/.update.lock"
flock -n 9 || { say "another update is running"; exit 0; }

git -C "$src" rev-parse --git-dir >/dev/null 2>&1 || fail setup "$src is not a git checkout of Guild"
git -C "$src" fetch -q origin || transient "git fetch failed in $src"
sha=$(git -C "$src" rev-parse refs/remotes/origin/HEAD) || fail setup "no origin/HEAD in $src"
id=g-${sha:0:12}

if [ -e "$root/installed/$id" ]; then
  all_clear
  if [ "$(git -C "$src" rev-parse HEAD)" != "$sha" ]; then
    git -C "$src" -c advice.detachedHead=false checkout -q --detach "$sha" ||
      fail "$id-src" "installed $id but cannot move $src to it"
  fi
  exit 0
fi
if [ -e "$root/failed/$id" ]; then
  streak_over
  say "$id failed to deploy: $(cat "$root/failed/$id"); delete $root/failed/$id to retry"
  exit 1
fi

repo=${GUILD_UPDATE_REPO:-$(git -C "$src" remote get-url origin |
  sed -E 's#^(git@github\.com:|https://github\.com/|ssh://git@github\.com/)##; s#\.git$##')}
[[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] ||
  fail setup "cannot read owner/repo from the origin URL in $src; set GUILD_UPDATE_REPO"

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tree=$(git -C "$src" rev-parse "$sha^{tree}")
# Pins for evidence must come from the candidate commit, not the installed checkout.
pins_file=$(mktemp "${TMPDIR:-/tmp}/guild-update-pins.XXXXXX")
git -C "$src" show "$sha:tests/member-pins.json" >"$pins_file" || {
  rm -f "$pins_file"
  fail setup "cannot read tests/member-pins.json at $sha"
}
local_ok=0
if [ -x "$here/guild-local-test" ]; then
  if "$here/guild-local-test" status --repo "$repo" --sha "$sha" --tree "$tree" --pins "$pins_file" >/dev/null; then
    local_ok=1
  fi
fi
rm -f "$pins_file"
# Distinguish verified disabled from API/import errors (do not treat errors as disabled).
actions_probe=$(python3 -c "
import sys
sys.path.insert(0, r'$here')
import guild_local_test as t
try:
    print('1' if t.actions_enabled(r'$repo') else '0')
except Exception as exc:
    print('error', exc, file=sys.stderr)
    sys.exit(2)
") || {
  rc=$?
  if [ "$rc" -eq 2 ]; then
    transient "cannot read Actions permissions for $repo"
  fi
  fail setup "cannot probe Actions permissions for $repo"
}
actions_on=$actions_probe

# Workflow runs, not check runs: a workflow run completes only when all its jobs have.
runs=$(gh api "repos/$repo/actions/runs?head_sha=$sha&event=push&per_page=100" \
  --jq '.workflow_runs[] | "\(.status) \(.conclusion // "-") \(.name)"') ||
  transient "cannot read CI for $sha"

# Completed CI failures stay blocking; local-test never overrides them.
if [ -n "$runs" ]; then
  bad=$(grep -E '^completed ' <<<"$runs" | grep -Ev '^completed (success|skipped|neutral) ' || true)
  if [ -n "$bad" ]; then
    fail "$id-ci" "CI did not pass on $sha: $(tr '\n' ';' <<<"$bad")"
  fi
fi

incomplete=0
if [ -z "$runs" ] || grep -qv '^completed ' <<<"$runs"; then
  incomplete=1
fi

if [ "$actions_on" -eq 1 ]; then
  # While Actions is on, pending/empty runs still wait even if local-test exists.
  if [ "$incomplete" -eq 1 ]; then
    [ -e "$state/waiting-$id" ] || { rm -f "$state"/waiting-*; touch "$state/waiting-$id"; }
    waited=$(( $(date +%s) - $(stat -c %Y "$state/waiting-$id") ))
    [ "$waited" -lt "$wait_limit_s" ] || fail "$id-wait" "no finished CI for $sha after 24 hours"
    say "CI not finished for $sha; waiting"
    exit 0
  fi
  rm -f "$state"/waiting-*
elif [ "$local_ok" -eq 1 ]; then
  say "local-test passed for tree $tree (not GitHub CI)"
  rm -f "$state"/waiting-*
else
  fail "$id-local" "Actions disabled and no validated local-test for $sha tree $tree"
fi

deploy_failed() {
  printf '%s\n' "$1" >"$root/failed/$id"
  fail "$id-deploy" "$1"
}

candidate=$root/.candidate
rm -rf "$candidate"
mkdir -p "$candidate"
trap 'rm -rf "$candidate"' EXIT
git -C "$src" archive "$sha" | tar -x -C "$candidate" || fail setup "cannot export $sha from $src"
release=(python3 "$candidate/bin/guild-release")

members=$(python3 -c 'import json,sys; print(" ".join(json.load(open(sys.argv[1]))))' \
  "$candidate/tests/member-pins.json") || deploy_failed "cannot read tests/member-pins.json at $sha"
for member in $members; do
  git -C "$sources/$member" rev-parse --git-dir >/dev/null 2>&1 ||
    fail setup "missing member checkout $sources/$member"
  git -C "$sources/$member" fetch -q origin || transient "git fetch failed for $member in $sources"
done
streak_over

if [ -d "$root/releases/$id" ]; then
  out=$("${release[@]}" switch --root "$root" --release-id "$id" 2>&1) ||
    deploy_failed "switch to $id failed: $(tail -n 3 <<<"$out" | tr '\n' ' ')"
else
  out=$("${release[@]}" deploy --root "$root" --sources-dir "$sources" --release-id "$id" 2>&1) ||
    deploy_failed "deploy of $id failed: $(tail -n 3 <<<"$out" | tr '\n' ' ')"
fi
touch "$root/installed/$id"
all_clear
say "activated $id"

# A switch moves only the release dir. Each member's --check against HOME reports the
# wrappers, hooks, units and skills there that do not match the new release.
lagging=
for member in $members; do
  installer=$root/current/code/$member/install.sh
  [ -f "$installer" ] || continue
  if ! out=$(bash "$installer" --check 2>&1); then
    lagging="$lagging $member"
    say "HOME lags $id for $member: $(tail -n 3 <<<"$out" | tr '\n' ' ')"
  fi
done
[ -z "$lagging" ] ||
  ping "$id-home" HOME-LAG "$id is active but HOME lags it for:$lagging (install.sh --check)"

# Unit files can link through current/, so the switch may have changed their text.
[ -z "$restart_units" ] || systemctl --user daemon-reload || say "daemon-reload failed"
for unit in $restart_units; do
  systemctl --user try-restart "$unit" || say "try-restart $unit failed"
done
"${release[@]}" prune --root "$root" >/dev/null || say "prune failed"
git -C "$src" -c advice.detachedHead=false checkout -q --detach "$sha" ||
  fail "$id-src" "activated $id but cannot move $src to it"
