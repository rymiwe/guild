#!/usr/bin/env python3
"""Run the suites GitHub Actions would run, on this machine, while Actions is off.

usage: guild-local-ci

For each repo in SUITES whose Actions is off, it finds the commits a deploy gate waits on that carry
no local-tests status yet: a member's trunk head that differs from its Guild pin, and the head of each
open pin/* PR in Guild. It runs that repo's suite on each, oldest gate first, through guild-local-pass,
which posts the result on the exact commit. A failed run is not retried; guild-pin reports it, and a
rerun of guild-local-pass by hand replaces it. Each run's output goes to
$XDG_STATE_HOME/guild/local-ci/<repo>-<sha12>.log. Exits 1 when any suite failed.
"""
from __future__ import annotations

import fcntl
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MAIN_REF = "refs/guild-local-ci/main"
CONTEXT = "local-tests"
CI_STEP = str(ROOT / "scripts" / "ci-step")
SOURCES = Path(os.environ.get("GUILD_MEMBER_SOURCES_DIR") or Path.home() / "code")
IDENTITY = "GIT_AUTHOR_NAME=ci GIT_AUTHOR_EMAIL=ci@example.invalid GIT_COMMITTER_NAME=ci GIT_COMMITTER_EMAIL=ci@example.invalid"
# Each repo's suite: the test steps of its own workflow at the commit under test, and the env the
# workflow's job and steps set (CI_ENV for ci-step). Guild's own suite needs the pinned members.
SUITES: dict[str, tuple[list[str], str]] = {
    "guild": (["scripts/local-suite"], ""),
    "bridgekeeper": (["bash", CI_STEP, ".github/workflows/test.yml",
                      "Git identity for test repos", "Push guard tests", "Gate tests"], ""),
    "bopeep": (["bash", CI_STEP, ".github/workflows/tests.yml", "Run the test suite"], ""),
    "conclave": (["bash", CI_STEP, ".github/workflows/tests.yml", "Run the suite"],
                 f"{IDENTITY} BRIDGEKEEPER_HOME={SOURCES / 'bridgekeeper'}"),
    "quartermaster": (["bash", CI_STEP, ".github/workflows/tests.yml", "Run the test suite"], ""),
    "thresher": (["bash", CI_STEP, ".github/workflows/tests.yml", "Run the test suite"], ""),
}


def sh(*cmd: str) -> str:
    out = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)
    if out.returncode != 0:
        raise RuntimeError(f"guild-local-ci: {' '.join(cmd)} failed: {out.stderr.strip()}")
    return out.stdout.strip()


def actions_on(slug: str) -> bool:
    # A read error raises: no suite runs on a guess.
    return sh("gh", "api", f"repos/{slug}/actions/permissions", "--jq", ".enabled") == "true"


def has_status(slug: str, sha: str) -> bool:
    return sh("gh", "api", f"repos/{slug}/commits/{sha}/status", "--jq",
              f'[.statuses[] | select(.context == "{CONTEXT}")] | length') != "0"


def waiting() -> list[tuple[str, str]]:
    """(repo, sha) pairs a gate waits on that no local run has looked at: members first, then pin PRs."""
    m = re.search(r"github\.com[:/]+([^/]+)/([^/]+?)(?:\.git)?$", sh("git", "config", "--get", "remote.origin.url"))
    if not m:
        raise RuntimeError("guild-local-ci: origin is not on GitHub")
    owner, guild = m.group(1), f"{m.group(1)}/{m.group(2)}"
    sh("git", "fetch", "-q", "--no-write-fetch-head", "--refmap=", "origin", f"+refs/heads/main:{MAIN_REF}")
    pins = json.loads(sh("git", "show", f"{MAIN_REF}:tests/member-pins.json"))
    todo = []
    for member, pin in pins.items():
        slug = f"{owner}/{member}"
        if member not in SUITES or actions_on(slug):
            continue
        head = sh("gh", "api", f"repos/{slug}/commits/HEAD", "--jq", ".sha")
        if head != pin and not has_status(slug, head):
            todo.append((member, head))
    if not actions_on(guild):
        prs = json.loads(sh("gh", "pr", "list", "--repo", guild, "--state", "open",
                            "--json", "headRefName,headRefOid,isCrossRepository") or "[]")
        for pr in prs:
            if str(pr["headRefName"]).startswith("pin/") and not pr.get("isCrossRepository") \
                    and not has_status(guild, str(pr["headRefOid"])):
                todo.append(("guild", str(pr["headRefOid"])))
    return todo


def main(argv: list[str]) -> int:
    if argv:
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        return 2
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "guild"
    state.mkdir(parents=True, exist_ok=True)
    with open(state / "local-ci.lock", "w", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print("guild-local-ci: another run is in progress", file=sys.stderr)
            return 0
        try:
            todo = waiting()
        except RuntimeError as exc:
            print(exc, file=sys.stderr)
            return 1
        if not todo:
            print("guild-local-ci: no commit waits on a local run")
        failed = []
        for repo, sha in todo:
            cmd, ci_env = SUITES[repo]
            env = {**os.environ, "CI_ENV": ci_env, "GUILD_MEMBER_SOURCES_DIR": str(SOURCES)}
            log = state / "local-ci" / f"{repo}-{sha[:12]}.log"
            log.parent.mkdir(exist_ok=True)
            with open(log, "w", encoding="utf-8") as out:
                rc = subprocess.run([str(ROOT / "bin" / "guild-local-pass"), repo, sha, "--", *cmd],
                                    env=env, stdout=out, stderr=subprocess.STDOUT).returncode
            print(f"guild-local-ci: {repo} {sha[:7]} {'passed' if rc == 0 else 'failed'}; log {log}", flush=True)
            if rc:
                failed.append(f"{repo} {sha[:7]}")
        if failed:
            print(f"guild-local-ci: failed: {', '.join(failed)}", file=sys.stderr)
            return 1
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
